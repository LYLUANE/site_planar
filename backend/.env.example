# Copie para .env e preencha. O .env NUNCA deve ir para o git.

PORT=3000

# Endereço(s) do frontend que podem chamar a API, separados por vírgula
FRONTEND_URL=http://localhost:5173,https://lyluane.github.io

# Chave para assinar os tokens. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRA_EM=1h

# Login e senha do administrador (escolha os seus; senha com 8+ caracteres)
ADMIN_LOGIN=
ADMIN_SENHA=

# Banco: sqlite (padrão, arquivo local) ou postgres
DB_TYPE=sqlite
DB_SQLITE_ARQUIVO=data/planar.sqlite
# DATABASE_URL=postgres://usuario:senha@host:5432/planar

UPLOADS_DIR=uploads
SEED_PRODUTOS=true
